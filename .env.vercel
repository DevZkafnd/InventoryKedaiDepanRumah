# ========================================
# ENVIRONMENT VARIABLES UNTUK VERCEL
# ========================================
# Copy paste values ini ke Vercel Dashboard
# Settings → Environment Variables
# ========================================

# ============= WAJIB (REQUIRED) =============
# Ini HARUS diisi agar aplikasi bisa jalan!

# Django Secret Key (untuk enkripsi & security)
DJANGO_SECRET_KEY=bbr+#nr)bxx^rgno4ki@=ecu*6bl^i-3^cu*v+=rqa6o0^1#h+

# Debug mode (HARUS False untuk production!)
DJANGO_DEBUG=False

# Allowed hosts (domain yang boleh akses aplikasi)
DJANGO_ALLOWED_HOSTS=.vercel.app

# Database PostgreSQL dari Neon
DATABASE_URL=postgresql://neondb_owner:npg_j8ThFKgdmpw7@ep-orange-wildflower-aztc4bgj.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Login security settings
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=30

# Allow user to change password
ALLOW_PW_CHANGE=True

# ============= OPTIONAL (AI Assistant) =============
# Isi jika mau fitur AI Assistant aktif
# Kamu punya 2 pilihan: Groq (lebih cepat) atau Gemini (Google)

# AI Provider: 'groq' atau 'gemini'
# Ganti sesuai pilihan kamu, atau tambahkan keduanya untuk backup
AI_PROVIDER=groq

# Groq API Key (Lebih Cepat, Model: Llama 3.1)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Gemini API Key (Google AI, Model: Gemini 1.5 Flash)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# CATATAN: 
# - Kamu bisa tambahkan kedua API keys
# - Tinggal ganti AI_PROVIDER untuk switch provider
# - Groq: Lebih cepat, rate limit 10 req/min
# - Gemini: Google AI, rate limit 15 req/min
# - API keys JANGAN di-commit ke GitHub! Simpan di Vercel only!

# ============= OPTIONAL (Email Service) =============
# Isi jika mau email notifications/password reset

# MAIL_SERVICE_BACKEND=anymail.backends.sparkpost.EmailBackend
# MAIL_SERVICE_API_KEY=YOUR_SPARKPOST_API_KEY
# MAIL_SERVICE_API_URL=https://api.sparkpost.com/api/v1
# MAIL_DEFAULT_FROM=noreply@yourdomain.com
# MAIL_SERVER_EMAIL=server@yourdomain.com

# ============= OPTIONAL (Logging) =============
# Kosongkan untuk production (Vercel sudah punya logging)

# LOG_FILE=

# ========================================
# CATATAN PENTING:
# ========================================
# 1. Jangan commit file ini ke GitHub! (sudah ada di .gitignore)
# 2. Untuk local development, gunakan file .env
# 3. Untuk production Vercel, copy values dari file ini ke Vercel Dashboard
# 4. Environment variables yang commented (#) tidak perlu ditambahkan
